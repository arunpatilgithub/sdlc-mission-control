{
  "name": "sdlc-mission-control",
  "version": "0.1.0",
  "private": true,
  "description": "Developer-controlled autonomous missions for Azure DevOps User Stories",
  "type": "module",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "validation:replay": "tsx src/dev/validation-replay.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "config:validate": "npm run build && node dist/index.js config validate",
    "ui:build": "vite build --config ui/vite.config.ts",
    "dashboard": "npm run build && npm run ui:build && node dist/server/backlog-cache.js && node dist/server/server.js"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.10"
  }
}
